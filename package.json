{
  "name": "create-hazal-app",
  "version": "0.2.2",
  "description": "Spring Boot + frontend + Docker projelerini hızlıca kuran masaüstü ve CLI aracı",
  "type": "module",
  "bin": {
    "create-hazal-app": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "ui": "vite",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "shortcut:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shortcut-windows.ps1",
    "build:ui-docker": "node scripts/build-ui-docker.mjs",
    "update": "node scripts/build-ui-docker.mjs && tsc"
  },
  "keywords": [
    "cli",
    "scaffold",
    "spring-boot",
    "react",
    "docker",
    "starter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "adm-zip": "^0.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "dist/main/index.js",
  "author": "Hazallul",
  "build": {
    "appId": "com.hazallul.createhazalapp",
    "productName": "create-hazal-app",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon.png",
      "build/icon.ico",
      "!dist/cli/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "create-hazal-app"
    }
  }
}
